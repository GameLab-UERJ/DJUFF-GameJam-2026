"res://Entities/": "orange",
"res://Levels/": "red",
"res://UI/": "green",
"res://addons/": "gray",
"res://dialogue/": "yellow",
"res://resource/": "blue",
"res://systems/": "teal",
"res://tests/": "purple"
}

